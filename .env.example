# ==============================================================================
# TrueForge Agent Harness - Environment Configuration
# Copy this file to .env:  cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Groq LLM API Configuration (Recommended)
# Obtain your free API key at: https://console.groq.com/keys
# ------------------------------------------------------------------------------
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Supported Groq Models:
# - llama-3.3-70b-versatile (Recommended - high intelligence & speed)
# - llama-3.1-70b-versatile
# - llama-3.1-8b-instant (Fastest latency)
# - mixtral-8x7b-32768
# - gemma2-9b-it

# ------------------------------------------------------------------------------
# 2. Server & Security Settings
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
NODE_ENV=development

# ------------------------------------------------------------------------------
# 3. Human-In-The-Loop Approval Authentication
# Used to verify patch reviews and close-loop investigations
# ------------------------------------------------------------------------------
HARNESS_APPROVAL_TOKEN=change-me-for-local-approval
HARNESS_REVIEWER_ID=local-reviewer
